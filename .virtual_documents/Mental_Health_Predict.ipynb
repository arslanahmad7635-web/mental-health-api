
import numpy as np 
import pandas as pd 
import matplotlib.pyplot as plt 
import seaborn as sns


df = pd.read_csv('Student Social Media And Mental Health Impact.csv')


df.shape
df.columns.tolist


df.head()


df.isnull().sum()


